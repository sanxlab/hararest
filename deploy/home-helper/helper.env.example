# ~/.config/hararest-home-helper.env on the home server (chmod 600).
# Generate once with: openssl rand -hex 32
HOME_HELPER_TOKEN=replace-with-private-home-helper-token
# Tailnet IPv4 of the home server (tailscale ip -4).
HOME_HELPER_BIND=100.112.3.60
# Netscape cookie export used by yt-dlp on Heroku and by the lyrics lookup.
HOME_HELPER_COOKIE_PATH=/home/ihsan/.local/share/hararest-home-helper/cookies.txt
PYTHONPATH=/home/ihsan/.local/share/hararest-home-helper/deps
