# Heroku Config Vars for Hararest. Allow TCP 20129 to the helper in the tailnet ACL.
# One URL serves both timed lyrics and the YouTube cookie file.
HOME_HELPER_URL=http://100.112.3.60:20129
# Match HOME_HELPER_TOKEN in ~/.config/hararest-home-helper.env on the home server.
HOME_HELPER_TOKEN=replace-with-private-home-helper-token
# Use a key authorized to join the tailnet as the Hararest node.
TAILSCALE_AUTHKEY=replace-with-tailnet-auth-key
TAILSCALE_HOSTNAME=heroku-hararest
# YTDLP_COOKIES_BASE64 is no longer needed when HOME_HELPER_URL is set.
