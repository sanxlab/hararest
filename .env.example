# Docker Compose host binding
TAILSCALE_IP=127.0.0.1

# App
PORT=1337
# Set to 1 behind the Heroku router; keep 0 when serving clients directly.
TRUST_PROXY_HOPS=0
TMP_DIR=./tmp

# Optional override for browser/WS links. By default Kotonehara supplies the
# origin of BASEAPI_URL, so API and WS share the same domain and port.
# Set only when the bot uses an internal API address but phones need a public one.
# PLAYER_PUBLIC_URL=https://api.example.com

# Browser executable (optional, only for npm run test:player-browser)
# Production Docker no longer installs Chromium; tests can use local Chrome.
# The browser test also checks common Chromium paths if this does not exist.
PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# YouTube / yt-dlp
# Do not set YTDLP_PATH here so local dev uses src/config/default.ts fallback
# ./bin/yt-dlp, while Docker keeps the Dockerfile value /usr/local/bin/yt-dlp.
YTDLP_COOKIES_PATH=./cookies/yt-dlp_cookies.txt
# Optional for Heroku: base64 of a Netscape cookie file, restored privately at boot.
# Takes precedence over YTDLP_COOKIES_PATH. Store the actual value in Config Vars.
YTDLP_COOKIES_BASE64=
# Optional external PO token service. Compose supplies its internal service URL.
YTDLP_POT_PROVIDER_URL=

# Instagram/Facebook fallback scrapers
# Do not set PYTHON_BIN here so Docker keeps /opt/media-fallback/bin/python.
INSTAGRAM_FALLBACK_PYTHON_SCRIPT=./src/modules/instagram/snapinsta_scraper.py
FACEBOOK_FALLBACK_PYTHON_SCRIPT=./src/modules/facebook/fdown_scraper.py
INSTAGRAM_COOKIE_FILE=./cookies/www.instagram.com_cookies.txt
# Brave Search API
BRAVE_SEARCH_API_KEY=

# Optional Bilibili login cookie value for qualities allowed by your account.
# Use only the SESSDATA value (raw or browser percent-encoded), not a Cookie header.
# Restart the app after changing .env; recreate the service when using Compose.
BILIBILI_SESSDATA=
