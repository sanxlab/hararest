[Unit]
Description=Hararest private home helper (lyrics + YouTube cookies)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/hararest-home-helper
EnvironmentFile=%h/.config/hararest-home-helper.env
ExecStart=/usr/bin/python3 %h/.local/share/hararest-home-helper/server.py
Restart=on-failure
RestartSec=5
MemoryHigh=128M
MemoryMax=192M
TasksMax=8
CPUQuota=50%
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
