# Home server helper: allow TCP 20129 to this destination in the tailnet ACL.
YTMUSIC_HELPER_URL=http://100.112.3.60:20129
# Match LYRICS_HELPER_TOKEN in ~/.config/hararest-lyrics.env on the home server.
YTMUSIC_HELPER_TOKEN=replace-with-private-home-helper-token
# Use a key authorized to join the tailnet as the Hararest node.
TAILSCALE_AUTHKEY=replace-with-tailnet-auth-key
TAILSCALE_HOSTNAME=heroku-hararest
