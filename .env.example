# Network
TAILSCALE_IP=127.0.0.1
PORT=1337
TRUST_PROXY_HOPS=0

# Runtime storage
TMP_DIR=./tmp

# Optional public origin for the music player when the bot uses an internal URL.
# PLAYER_PUBLIC_URL=https://api.example.com

# YouTube / yt-dlp
# Use 2 for a small server; valid range is 1-8.
YTDLP_CONCURRENCY=2
YTDLP_COOKIES_PATH=./cookies/yt-dlp_cookies.txt
# Optional base64-encoded Netscape cookie file. Takes precedence over the path above.
YTDLP_COOKIES_BASE64=
# Optional PO token provider. Docker Compose sets its internal default automatically.
YTDLP_POT_PROVIDER_URL=

# Fallback scraper scripts
INSTAGRAM_FALLBACK_PYTHON_SCRIPT=./src/modules/instagram/snapinsta_scraper.py
FACEBOOK_FALLBACK_PYTHON_SCRIPT=./src/modules/facebook/fdown_scraper.py
INSTAGRAM_COOKIE_FILE=./cookies/www.instagram.com_cookies.txt

# Optional integrations
BRAVE_SEARCH_API_KEY=
BILIBILI_SESSDATA=

# RPG gateway (optional; configure together with Kotonehara's RPG_ENABLED=true).
# Upstream is the BOT origin, never the Hararest origin/player login link.
# Dev VPS (internal Docker):
# RPG_UPSTREAM_URL=http://kotonehara-dev:8089
# Heroku: HTTPS origin of the Kotonehara web app, without /rpg/api.
# RPG_UPSTREAM_URL=https://your-bot-app.herokuapp.com
# Configure RPG_PUBLIC_URL=https://your-hararest-domain in the BOT app.
# See docs/heroku-rpg.md for PostgreSQL and worker-to-web setup.
# Same random secret as Kotonehara; generate once with: openssl rand -hex 32
RPG_GATEWAY_SECRET=
